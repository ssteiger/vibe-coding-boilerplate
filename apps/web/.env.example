# Public URLs
SUPABASE_API_URL="http://127.0.0.1:54621"
SUPABASE_GRAPHQL_URL="http://127.0.0.1:54621/graphql/v1"
SUPABASE_STORAGE_URL="http://127.0.0.1:54621/storage/v1/s3"
SUPABASE_STUDIO_URL="http://127.0.0.1:54623"
INBUCKET_URL="http://127.0.0.1:54624"
SUPABASE_ANON_KEY=""

# Private configuration
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54622/postgres"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
# Populate from `supabase status` output after running `bun run dev:db`.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_S3_ACCESS_KEY=""
SUPABASE_S3_SECRET_KEY=""
SUPABASE_S3_REGION="local"

# Optional language model for the assistant in the header (Cmd+J). Leave empty
# and the assistant says how to turn it on. Provider is "openai", "anthropic"
# or "cursor" (a Cursor API key from cursor.com/dashboard -> Integrations;
# CURSOR_API_KEY works too). The model defaults to gpt-4o-mini,
# claude-3-5-haiku-latest or composer-2.5 when unset.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
# Optional API root, for an OpenAI-compatible local server such as Ollama
# (http://127.0.0.1:11434/v1) or LM Studio.
AI_BASE_URL=""
